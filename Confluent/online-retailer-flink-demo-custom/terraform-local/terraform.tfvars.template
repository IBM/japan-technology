# Confluent Cloud API Key (generated via Confluent CLI)
# Run: confluent api-key create --resource cloud --description "Local Workshop API Key"
confluent_cloud_api_key    = "your-cloud-api-key"
confluent_cloud_api_secret = "your-cloud-api-secret"

# Resource name prefix
prefix = "local-workshop"

# Confluent Cloud region (choose the closest region to you)
# Available regions: us-east-1, us-west-2, eu-west-1, ap-southeast-1, etc.
cloud_region = "us-east-1"